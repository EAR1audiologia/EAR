# ==============================
# EAR Audiología Avanzada — Environment Variables Template
# Copia este archivo como `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` a Git (ya está en .gitignore por defecto en Next).
# Prefijo NEXT_PUBLIC_ = accesible por cliente (se envían al navegador).
# Sin prefijo NEXT_PUBLIC_ = solo servidor Node (NO se expone).
# ==============================

# ——— Brand & Sitio ———
NEXT_PUBLIC_BRAND_NAME="EAR Audiología Avanzada"
NEXT_PUBLIC_BRAND_SHORT_NAME="EAR"
NEXT_PUBLIC_SITE_URL=https://www.earaudiologiaavanzada.com/
NEXT_PUBLIC_CITY=Albacete

# ——— Teléfonos (formato internacional: +34XXXXXXXXX) ———
NEXT_PUBLIC_PHONE_LANDLINE=+34967031036
NEXT_PUBLIC_PHONE_WHATSAPP=+34604480628

# ——— Dirección de la clínica ———
NEXT_PUBLIC_ADDRESS_STREET="C/ Carmen, 17"
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=02005
NEXT_PUBLIC_ADDRESS_CITY=Albacete
NEXT_PUBLIC_ADDRESS_COUNTRY=ES

# ——— Email de contacto ———
NEXT_PUBLIC_CONTACT_EMAIL=ear.audiologia.avanzada@gmail.com

# ——— Google Maps ———
NEXT_PUBLIC_MAPS_EMBED_URL=
NEXT_PUBLIC_MAPS_DIRECTIONS_URL=

# ——— Prueba social (Google Reviews) ———
NEXT_PUBLIC_GOOGLE_RATING_TEXT=
NEXT_PUBLIC_GOOGLE_REVIEWS_COUNT=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

# ——— Distributed Rate Limiting — Vercel KV / Upstash Redis ———
# Añade "Vercel KV" desde Marketplace de Vercel (1-click). Crea DB y pega aquí:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa Upstash Redis (mismas variables REST compatibles)
